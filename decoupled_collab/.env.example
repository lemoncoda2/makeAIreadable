# Copy to .env on the training server and fill secrets there.
# Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional experiment tracking. Leave blank to keep W&B disabled.
WANDB_API_KEY=
WANDB_PROJECT=decoupled-collab

# Server-local cache and V100 runtime settings.
HF_HOME=/root/makeAIreadable-20260814/hf_cache
WANDB_MODE=disabled
